# Render API Configuration
# Set this to your Render app URL to enable syncing
RENDER_API_URL=https://your-render-app.onrender.com

# Sync token for authenticating sync requests between localhost and Render
# Make sure this is the same on both instances
SYNC_TOKEN=your-secure-sync-token-here

# Stripe Configuration (optional but recommended)
# Get your keys from https://dashboard.stripe.com/apikeys
# Secret key for backend (server-side only)
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Public key for frontend (can be public)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_test_key_here

# Node Environment
NODE_ENV=development

# Database Configuration (if using database instead of JSON)
# DATABASE_URL=your_database_url_here

# Email Configuration (optional)
# SMTP server settings for password reset and transactional emails
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@axoshop.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
