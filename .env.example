# Render API Configuration
# Set this to your Render app URL to enable syncing
RENDER_API_URL=https://your-render-app.onrender.com

# Sync token for authenticating sync requests between localhost and Render
# Make sure this is the same on both instances
SYNC_TOKEN=your-secure-sync-token-here

# Stripe Configuration (optional but recommended)
# Get your keys from https://dashboard.stripe.com/apikeys
# Secret key for backend (server-side only)
STRIPE_SECRET_KEY=sk_test_your_test_key_here

# Public key for frontend (can be public)
VITE_STRIPE_PUBLIC_KEY=pk_test_your_test_key_here

# Node Environment
NODE_ENV=development

# Database Configuration (if using database instead of JSON)
# DATABASE_URL=your_database_url_here

# Email Configuration (optional)
# SMTP server settings for password reset and transactional emails
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@axoshop.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
# Discord Configuration (optional)
# Get your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Client ID and Guild ID
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_GUILD_ID=your_discord_guild_id

# Discord Channel IDs for notifications
# Orders channel where new orders will be posted
DISCORD_ORDERS_CHANNEL_ID=your_orders_channel_id

# Admin role ID for command permissions
DISCORD_ADMIN_ROLE_ID=your_admin_role_id

# PayPal Configuration (optional)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET_KEY=your_paypal_secret_key