STRIPE_SECRET_KEY=sk_test_placeholder
VITE_STRIPE_PUBLIC_KEY=pk_test_placeholder
PORT=5000

# Database Configuration - PostgreSQL (Drizzle ORM)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://user:password@localhost:5432/axosshop
# For Neon (serverless PostgreSQL): postgresql://user:password@[project-id].neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://localhost:5432/axosshop

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here_keep_secret
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_discord_guild_id_here
DISCORD_ORDERS_CHANNEL_ID=1445712789141454950
DISCORD_ADMIN_ROLE_ID=your_admin_role_id_here
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here
VITE_DISCORD_BOT_ID=your_discord_bot_id_here

# Email Configuration
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@axosshop.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_SECURE=false

# API Configuration
RENDER_API_URL=https://axosshop-i635.onrender.com
